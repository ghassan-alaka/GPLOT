# MIMIC_TPW2.rgb  -  CIMSS MIMIC-TPW2 approximation
#
# 256-sample LinearSegmentedColormap built from 10 calibrated RGB
# control stops (user-sampled directly off the CIMSS published
# MIMIC-TPW2 colorbar). Anchor values at 10-mm intervals:
#
#     0 mm: 188,130,99    (brown / tan)
#    10 mm: 162, 70,124   (dark magenta / wine)
#    20 mm:  97, 88,197   (indigo blue)
#    30 mm: 102,211,255   (cyan / light blue)
#    40 mm: 173,255,148   (light green)
#    45 mm: 255,252,144   (yellow -- intermediate stop to enforce
#                          the yellow band between green and orange)
#    50 mm: 255,185, 77   (orange)
#    60 mm: 181, 69, 39   (dark red)
#    70 mm: 189, 84,120   (red-pink)
#    76 mm: 218,131,185   (pale pink -- extend-over tail)
#
# Used by the TPW_MSLP recipe to give GPLOT TPW panels the
# operational MIMIC look that observing-system imagery (e.g.,
# the published CIMSS MIMIC-TPW2 product) uses, replacing the
# generic BrBG diverging palette.
ncolors=256
