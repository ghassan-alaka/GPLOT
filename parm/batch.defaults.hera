# Default batch information for RDHPCS Hera
CPU_ACCT = aoml-hafs1
QOS = batch
PARTITION = hera
sbatch = /apps/slurm_hera/default/bin/sbatch
squeue = /apps/slurm_hera/default/bin/squeue
