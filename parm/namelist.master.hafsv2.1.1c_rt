; GPLOT POST-PROCESSING SYSTEM
; Namelist for Graphical Production

;================================================================
; User Input Section
; Change these settings to fit your personal needs.
;================================================================


;================================================================
; SECTION 1: Basic Variables
;================================================================

; 1A. EXPERIMENT NAME.
EXPT = hafsv2.1.1c_rt

; 1B. WHAT TYPES OF GRAPHICS DO YOU WANT?
DO_MAPS = True
DO_STATS = True
DO_SHIPS = True
DO_POLAR = True
DO_AIRSEA = True
DO_OCEAN_MAPS = True
DO_OCEAN_OBS = True

; 1C. DATA SOURCE
DSOURCE = HFSB_MULTISTORM

; 1D. IS THIS MULTISTORM DATA?
IS_MSTORM = True

; 1E. ENSEMBLE MEMBER NUMBER
ENSMEM = 0

; 1E. SYSTEM ENVIRONMENT
SYS_ENV = URSA

; 1F. FORECAST CYCLE
IDATE = 

; 1G. STORM ID
SID = 

; 1H. INPUT PATH
IDIR = /PLEASE/SET/THE/INPUT/PATH
ITAG =
EXT = .grb2

; 1I. OUTPUT PATH
ODIR = /PLEASE/SET/THE/OUTPUT/PATH
ODIR_TYPE = 1

; 1J. ATCF PATH
ATCF1_DIR = /PLEASE/SET/THE/ATCF1/DIRECTORY
ATCF1_TAG = trak.hfsb.atcfunix
ATCF2_DIR = /scratch4/HFIP/hwrfv3/noscrub/role.rthafsc/hafsv2.1.1c_rt/
ATCF2_TAG = hfsb_multistorm.trak.atcfunix

; 1K. ADECK & BDECK PATHS
ADECK_DIR = /scratch3/HFIP/hwrfv3/save/Bin.Liu/Verification/Statistics/real-time-2025_tmp
BDECK_DIR = /scratch3/HFIP/hwrfv3/save/Bin.Liu/Verification/Statistics/real-time-2025_tmp

; 1L. FORECAST HOUR INFORMATION
INIT_HR = 0
FNL_HR = 126
FMT_HR = 3

; 1M. TIME STEP FOR GRAPHICAL OUTPUT
DT = 3

; 1N. MASK TOPOGRAPHY
DO_TOPOMASK = False

; 1O. REMOVE WHITE SPACE
DO_RMWHITE = True

; 1P. TOGGLE TITLE
DO_SRCLBL = True

; 1S. FORCE
FORCE = False

; 1T. BATCH SUBMISSION MODE
;BATCH_MODE; = Foreground
;BATCH_MODE; = Background
BATCH_MODE = SBatch

; 1U. CONVERT FROM PNG TO GIF
;DO_CONVERTGIF; = False
DO_CONVERTGIF = True

; 1V. COMPUTER ACCOUNT (for BATCH_MODE = SBatch)
CPU_ACCT = rthafsc

;================================================================
; SECTION 2: GPLOT_Maps variables
;================================================================

; 2A. MAP GRAPHICS DOMAIN NAME
DOMAIN = d01 d03

; 2B. MAP GRAPHICS TIER
TIER = Tier1 Tier2

; 2C. MAP ATCF REQUIREMENT
ATCF_REQD = False

; 2D. MAP PIVOT LONGITUDE
PIV = 20



;================================================================
; SECTION 3: GPLOT_Stats variables
;================================================================

; 3A. MODEL NAMES
MORIG = HFSB
MCODE = HFXC
MCODEI = HXCI
MCODE12 = HXC2

; 3B. FORECAST GUIDANCE MODELS
TRKM = HFXC HFXB HFXA HFXM HFXO HFXJ HFSB HFSA HWRF AVNO HMON CTCX
INTM = HFXC HFXB HFXA HFXM HFXO HFXJ HFSB HFSA HWRF AVNO HMON DSHP LGEM CTCX
PRSM = HFXC HFXB HFXA HFXM HFXO HFXJ HFSB HFSA HWRF AVNO HMON CTCX
TRKMI = HXCI HXBI HXAI HXMI HXOI HXJI HFBI HFAI HWFI AVNI HMNI EGRI CTCI TVCN OFCL
INTMI = HXCI HXBI HXAI HXMI HXOI HXJI HFBI HFAI HWFI HMNI DSHP LGEM CTCI IVCN OFCL
TRKMT = HFXC HFXB HFXA HFXM HFXO HFXJ HFSB HFSA HWRF HMON AVNO OFCL
INTMT = HFXC HFXB HFXA HFXM HFXO HFXJ HFSB HFSA HWRF HMON DSHP OFCL

; 3C. VERIFICATION MODELS
ETM = HXCI HXBI HXAI HXMI HXOI HXJI HFBI HFAI HWFI GFSI HMNI CTCI TVCN OFCL
EIM = HXCI HXBI HXAI HXMI HXOI HXJI HFBI HFAI HWFI HMNI DSHP LGEM CTCI IVCN OFCL
LTM = HFXC HFXB HFXA HFXM HFXO HFXJ HFSB HFSA HWRF GFSO HMON CTCX
LIM = HFXC HFXB HFXA HFXM HFXO HFXJ HFSB HFSA HWRF GFSO HMON CTCX

; 3D. VERIFICATION TIMES
LEAD_TIMES = 00 12 24 36 48 60 72 84 96 108 120

; 3E. NUMBER OF TREND FORECASTS
NTREND = 6

; 3F. INTERPOLATION
DO_INTERP = True


;================================================================
; SECTION 4: GPLOT_Ships variables
;================================================================

;================================================================
; SECTION 5: GPLOT_Polar variables
;================================================================

PYTHONFILE = polar_cylindrical_structure.py
RESOLUTION = 2.0
RMAX = 600
LEVS = 46

;================================================================
; SECTION 6: GPLOT_Airsea variables
;================================================================
AIRSEA_PYTHONFILE = plot_airsea_pbl.py

;================================================================
; SECTION 7: GPLOT_Ocean_Maps variables
;================================================================
; Script to produce ocean map graphics
OCEAN_MAPS_PYTHONFILE = plot_ocean_maps.py
; Ocean data input directory
OCEAN_DIR = /PLEASE/SET/THE/OCEAN/INPUT/DIR
; Base coupled model config
OCEAN_DSOURCE = HAFS
; Ocean model (codes)
;OCEAN_SOURCE; = HYCOM
OCEAN_SOURCE = MOM6
; Ocean graphical regions to plot (LJG: 2025-04-30)
OCEAN_DOMAIN = domain d03
OCEAN_OBS_DOMAIN = d03
; OCEAN_OBS_DOMAIN = d03
; LJG 2024-09-02
;OCEAN_DOMAIN; = d03
; Ocean model configuration (e.g., for domain bounds and bathymetry)
OCEAN_CFG = NHC
FIX_DIR = /scratch3/HFIP/hwrfv3/noscrub/hafs-fix-files/hafs-20250205-fix/fix/fix_mom6/
; Does ocean model longitude need to be wrapped (-180-180 => 0-360)?
OCEAN_WRAP_LON = True
