#!/bin/sh

# MODULEFILE for JET (tcsh)

# Read the first arg
setenv A "$1"
if ( "${A}" == "" ) then
    setenv A "0"
endif

# Determine the GPLOT source code directory
if (! $?GPLOT_DIR) then
    set called=($_)
    setenv GPLOT_FILE `readlink -f $called[2]`
    setenv GPLOT_DIR `dirname "${GPLOT_FILE}" | rev | cut -d'/' -f2- | rev`
endif

# Initialize 'module' command
eval module help >& /dev/null
if ( $status == 1 ) then
    source /apps/lmod/lmod/init/csh
endif
if (! $?MODULEPATH) then
    setenv MODULEPATH "/apps/lmod/lmod/modulefiles/Core:/apps/modules/modulefiles/Linux:/apps/modules/modulefiles"
endif

# Turn off core dump files
limit core 0

# Load modules
module purge
module load gnu/13.2.0
module load intel/2023.2.0
if ( "${A}" == "0" ) then
    module load netcdf/4.6.1
    module load hdf5/1.10.4
    module load intelpython/3.6.5
    module use -a /contrib/met/modulefiles
    module load met/10.1.0
endif
module load netcdf/4.7.0
module load wgrib2/3.1.2_ncep
module load cairo/1.14.2
module load pyncl/6.6.2
module load grads/2.2.3
module load imagemagick/7.1.1-11

# NCL
setenv NCARG_COLORMAPS "${GPLOT_DIR}/sorc/GPLOT/ncl/colormaps:${NCARG_ROOT}/lib/ncarg/colormaps"

# Python 3 Anaconda
if ( "${A}" == "1" ) then
    setenv PYDIR "/mnt/lfs5/HFIP/hur-aoml/Ghassan.Alaka/software/anaconda/miniconda3_latest"
    # Python 3 Anaconda
    # >>> conda initialize >>>
    # !! Contents within this block are managed by 'conda init' !!
    if ( -f "${PYDIR}/etc/profile.d/conda.csh" ) then
        source "${PYDIR}/etc/profile.d/conda.csh" >& /dev/null
    else
        setenv PATH "${PYDIR}/bin:$PATH"
    endif
    # <<< conda initialize <<<
    conda activate GPLOT
endif

