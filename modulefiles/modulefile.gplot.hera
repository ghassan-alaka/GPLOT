#!/bin/sh

# MODULEFILE for HERA (bash)

# Read the first arg
A="${1:-0}"

# Determine the GPLOT source code directory
if [ ! -v GPLOT_DIR ]; then
    export GPLOT_DIR="$( echo "$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )" | rev | cut -d'/' -f2- | rev )"
fi

# Initialize 'module' command
if ( ! eval module help > /dev/null 2>&1 ) ; then
    source /apps/lmod/lmod/init/sh
fi
export MODULEPATH=${MODULEPATH:-"/apps/lmod/lmod/modulefiles/Core:/apps/modules/modulefiles/Linux:/apps/modules/modulefiles:/opt/cray/modulefiles:/opt/cray/craype/default/modulefiles"}

# Turn off core dump files
ulimit -c 0

# Load modules
module purge
if [ "${A}" -eq 0 ]; then
    # CentOS
    #module load intel/2022.1.2
    # ROCKY8
    module load gnu/13.2.0
    module load intel/2023.2.0
    module use -a /contrib/anaconda/modulefiles
    module load anaconda/latest
    #Lew.Gramer@noaa.gov 2025-05-14: per instructions from george.mccabe@noaa.gov
    # #module use -a /contrib/met/modulefiles
    # # Lew.Gramer@noaa.gov 2025-04-16: Commented out load of 10.1.0
    # #module load met/10.1.0
    module load netcdf/4.7.0
    module load wgrib2/3.1.2_ncep
    module use /contrib/METplus/modulefiles
    module load metplus/3.1
    module load met/11.0.2
    #LJG
    module load pyncl/6.6.2
    module load imagemagick/7.1.1-11
elif [ "${A}" -eq 1 ]; then
    # CentOS
    #module load gnu/9.2.0
    #module load wgrib2/3.1.1_ncep
    #module load grads/2.2.1
    # ROCKY8
    module load gnu/13.2.0
    module load intel/2023.2.0
    module load netcdf/4.7.0
    module load wgrib2/3.1.2_ncep
    module load grads/2.2.3
    module load imagemagick/7.1.1-11

    #Load Python
    module use /scratch4/AOML/aoml-hafs1/role.aoml-hafs1/software_hera/modulefiles
    module load python_GPLOT_env
fi

# NCARG_COLORMAPS — vestigial. The colormap palette files moved to
# sorc/GPLOT/python/colormaps/ (the loader uses an explicit path, not
# this env var). Kept for any downstream NCL-aware tooling that may
# still consult it; safe to remove in a future modulefile audit.
if [ "${A}" -eq 0 ]; then
    export NCARG_COLORMAPS="${GPLOT_DIR}/sorc/GPLOT/python/colormaps:${NCARG_ROOT}/lib/ncarg/colormaps"
fi

# Model Evaluation Tools (MET)

# Python 3 Anaconda
if [ "${A}" -eq 1 ]; then
    PYDIR="/scratch4/AOML/aoml-hafs1/role.aoml-hafs1/software_hera/miniconda3/"
    # >>> conda initialize >>>
    # !! Contents within this block are managed by 'conda init' !!
    __conda_setup="$('${PYDIR}/conda' 'shell.bash' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "${PYDIR}/etc/profile.d/conda.sh" ]; then
            . "${PYDIR}/etc/profile.d/conda.sh" &>/dev/null
        else
            export PATH="${PYDIR}/bin:$PATH"
        fi
    fi
    unset __conda_setup
    # <<< conda initialize <<<
    conda activate GPLOT_env
    export PYTHONBUFFERED=1
fi

