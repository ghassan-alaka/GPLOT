#!/bin/sh

# MODULEFILE for ORION (tcsh)

# Read the first arg
setenv A "$1"
if ( "${A}" == "" ) then
    setenv A "0"
endif

# Determine the GPLOT source code directory
if (! $?GPLOT_DIR) then
    set called=($_)
    set GPLOT_FILE = `readlink -f $called[2]`
    set GPLOT_DIR = `dirname "${GPLOT_FILE}" | rev | cut -d'/' -f2- | rev`
endif


# Initialize 'module' command
eval module help >& /dev/null
if ( $status == 1 ) then
    source /apps/lmod/lmod/init/csh
endif
if (! $?MODULEPATH) then
    setenv MODULEPATH "/apps/lmod/lmod/modulefiles/Core:/apps/modules/modulefiles/Linux:/apps/modules/modulefiles"
endif

# Turn off core dump files
limit core 0

# Load modules
module purge
if ( "${A}" == "0" ) then
    module use /apps/contrib/modulefiles
    module load intel-oneapi-compilers/2022.2.1
    module load met/11.1.0
    module load pyncl/6.6.2
    module load imagemagick
else if ( "${A}" == "1" ) then
    module use /apps/spack-managed/modulefiles/linux-rocky9-x86_64/Core
    module load grads/2.2.3
    module load wgrib2/3.1.1
    module load imagemagick
endif

# Python 3 Anaconda
if ( "${A}" == "1" ) then
    setenv PYDIR "/work2/noaa/aoml-hafs1/role-aoml-hafs1/software_hercules/miniconda3/"
    # >>> conda initialize >>>
    # !! Contents within this block are managed by 'conda init' !!
    if ( -f "${PYDIR}/etc/profile.d/conda.csh" ) then
        source "${PYDIR}/etc/profile.d/conda.csh" >& /dev/null
    else
        setenv PATH "${PYDIR}/bin:$PATH"
    endif
    # <<< conda initialize <<<
    setenv CONDA_SHLVL 0
    conda activate GPLOT_env
endif

# NCL
if ( "${A}" == "0" ) then
    setenv NCARG_COLORMAPS "${GPLOT_DIR}/sorc/GPLOT/python/colormaps:${NCARG_ROOT}/lib/ncarg/colormaps"
    echo "TEST NCARG_COLORMAPS" $NCARG_COLORMAPS
endif
