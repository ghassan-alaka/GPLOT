#!/bin/sh

# MODULEFILE for URSA (bash)

# Read the first arg
A="${1:-0}"

# Determine the GPLOT source code directory
if [ ! -v GPLOT_DIR ]; then
    export GPLOT_DIR="$( echo "$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )" | rev | cut -d'/' -f2- | rev )"
fi

# Initialize 'module' command
if ( ! eval module help > /dev/null 2>&1 ) ; then
    source /apps/lmod/lmod/init/sh
fi
export MODULEPATH=${MODULEPATH:-"/apps/lmod/lmod/modulefiles/Core:/apps/modules/modulefiles"}

# Turn off core dump files
ulimit -c 0

# Load modules
module purge
if [ "${A}" -eq 0 ]; then
	module use /scratch3/AOML/aoml-hafs1/Andrew.Hazelton/hafsv2p1_final/HAFS/sorc/hafs_graphics.fd/emc_graphics/modulefiles
	module load graphics.run.ursa  
    	module load met/11.1.1
	#module load ncl/6.6.2
	#export NCARG_ROOT=/scratch3/AOML/aoml-hafs1/role.aoml-hafs1/software/miniconda3/envs/pyncl/ 
	module use /scratch3/AOML/aoml-hafs1/role.aoml-hafs1/software/modulefiles
	module load pyncl
	module load python_pyncl
	module load imagemagick/7.1.1-29
elif [ "${A}" -eq 1 ]; then
    module load wgrib2/3.1.3_wmo
    module load grads/2.2.3
    #Load Python
    #module use /scratch3/AOML/aoml-hafs1/role.aoml-hafs1/software/modulefiles
    #module load python_GPLOT_env
    module load imagemagick/7.1.1-29
fi

# Python 3 Anaconda
if [ "${A}" -eq 0 ]; then
    PYDIR="/scratch3/AOML/aoml-hafs1/role.aoml-hafs1/software/miniconda3/"
    # >>> conda initialize >>>
    # !! Contents within this block are managed by 'conda init' !!
    __conda_setup="$('${PYDIR}/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "${PYDIR}/etc/profile.d/conda.sh" ]; then
            . "${PYDIR}/etc/profile.d/conda.sh" &>/dev/null
        else
            export PATH="${PYDIR}/bin:$PATH"
        fi
    fi
    unset __conda_setup
    export CONDA_SHLVL=0
    # <<< conda initialize <<<
    conda activate pyncl
    export PYTHONBUFFERED=1
fi
if [ "${A}" -eq 1 ]; then
    PYDIR="/scratch3/AOML/aoml-hafs1/role.aoml-hafs1/software/miniconda3/"
    # >>> conda initialize >>>
    # !! Contents within this block are managed by 'conda init' !!
    __conda_setup="$('${PYDIR}/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "${PYDIR}/etc/profile.d/conda.sh" ]; then
            . "${PYDIR}/etc/profile.d/conda.sh" &>/dev/null
        else
            export PATH="${PYDIR}/bin:$PATH"
        fi
    fi
    unset __conda_setup
    export CONDA_SHLVL=0
    # <<< conda initialize <<<
    conda activate GPLOT_env
    export PYTHONBUFFERED=1
fi

# NCARG_COLORMAPS — vestigial. The colormap palette files moved to
# sorc/GPLOT/python/colormaps/ (the loader uses an explicit path, not
# this env var). Kept for any downstream NCL-aware tooling that may
# still consult it; safe to remove in a future modulefile audit.
if [ "${A}" -eq 0 ]; then
    export NCARG_COLORMAPS="${GPLOT_DIR}/sorc/GPLOT/python/colormaps:${NCARG_ROOT}/lib/ncarg/colormaps"
    echo "TEST NCARG_COLORMAPS" $NCARG_COLORMAPS
fi
